{
  "manifest_version": 3,
  "name": "AI 工具箱",
  "short_name": "AI 工具箱",
  "version": "1.3.2",
  "description": "在 Edge 中完成摘要、翻译、润色、校对、回复、JSON、测验、FAQ、代码解释和报错诊断。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "打开 AI 工具箱",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://dashscope.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
